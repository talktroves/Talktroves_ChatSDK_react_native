{
  "name": "talktroves_chatsdk",
  "version": "1.2.0",
  "description": "TalkTroves visitor chat widget for React Native",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "react-native": "src/index.ts",
  "source": "src/index.ts",
  "files": [
    "lib",
    "src",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "clean": "node -e \"require('fs').rmSync('lib',{recursive:true,force:true})\"",
    "build": "npm run clean && tsc -p tsconfig.build.json",
    "prepublishOnly": "npm run typecheck && npm run build"
  },
  "peerDependencies": {
    "react": ">=18.0.0",
    "react-native": ">=0.72.0"
  },
  "dependencies": {
    "socket.io-client": "^4.8.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "react": "18.3.1",
    "react-native": "0.76.5",
    "typescript": "^5.7.2"
  },
  "keywords": [
    "react-native",
    "talktroves",
    "chat",
    "support",
    "widget",
    "socket.io"
  ],
  "author": "Numanshakir",
  "license": "MIT",
  "homepage": "https://github.com/Numanshakir/Talktroves_ChatSDK#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Numanshakir/Talktroves_ChatSDK.git",
    "directory": "packages/talktroves_chatsdk"
  },
  "bugs": {
    "url": "https://github.com/Numanshakir/Talktroves_ChatSDK/issues"
  },
  "publishConfig": {
    "access": "public"
  }
